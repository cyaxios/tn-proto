+    )
+    offer_digest = _sha256(_canonical_bytes(jwe_proof))
+    response = _sign_statement(
+        {
+            "accepted_offer_digest": offer_digest,
+            "ceremony_id": CEREMONY_ID,
+            "expires_at": "2026-07-11T14:11:00Z",
